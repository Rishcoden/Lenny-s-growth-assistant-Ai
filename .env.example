# Lenny Growth Assistant - Backend Environment Configuration

# Database Configuration
# PostgreSQL is the production standard (e.g. postgresql://user:password@localhost:5432/lenny_assistant)
# If DATABASE_URL is not set or PostgreSQL is unavailable locally, a local SQLite database (sqlite:///./lenny_growth_assistant.db) is used for development fallback.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_assistant

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=lenny_podcast

# Ollama Local LLM & Embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Default Generation Provider (ollama | openai | anthropic)
DEFAULT_LLM_PROVIDER=ollama

# Optional Cloud Providers (Leave empty to use local Ollama exclusively)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
